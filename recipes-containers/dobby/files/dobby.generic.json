{
  "paths": {
    "workspaceDir": "/var/volatile/rdk",
    "persistentDir": "/opt/persistent/rdk"
  },
  "logging": {
    "consoleSocket": "/tmp/dobbyPty.sock"
  },
  "network": {
    "externalInterfaces": [ "eth0", "wlan0" ],
    "addressRange": "100.64.11.0"
  },
  "apparmorSettings": {
    "enabled": false
  },
  "logRelay": {
    "syslog": {
      "enable": false,
      "socketPath": "/tmp/dobby-syslog"
    },
    "journald": {
      "enable": true,
      "socketPath": "/tmp/dobby-journald"
    }
  }
}
